 # ---- SmartCrop environment template ----
# Copy this file to .env and fill in real values. Never commit .env.

# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value

# MongoDB Atlas (primary database)
# Either set MONGODB_URI directly...
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
DATABASE_NAME=smartcrop

# ...or provide the parts separately (used when MONGODB_URI is empty)
MONGODB_ATLAS_USERNAME=
MONGODB_ATLAS_PASSWORD=
MONGODB_ATLAS_CLUSTER=
MONGODB_DB_NAME=smartcrop

# If MongoDB is unreachable, SmartCrop can run on a local JSON store.
USE_LOCAL_FALLBACK=true
LOCAL_STORE_PATH=instance/smartcrop_store.json

# External APIs.
# Weather: Open-Meteo (live, keyless, primary). WEATHER_API_KEY is an optional
# secondary source (OpenWeatherMap) used only if Open-Meteo is unreachable.
WEATHER_API_KEY=
# Chatbot LLM (optional). Without a key the assistant uses the built-in
# knowledge base.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=instance/uploads
